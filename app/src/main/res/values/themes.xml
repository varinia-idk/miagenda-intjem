<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MiAgendaINTJEM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MiAgenda.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MiAgenda.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MiAgenda.Large</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.MiAgenda.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.MiAgenda.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MiAgenda.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MiAgenda.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.MiAgenda.Label</item>
    </style>

    <style name="EstiloBotonPrincipal" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/fondo_boton_redondeado</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_large</item>
        <item name="android:paddingEnd">@dimen/spacing_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">@dimen/button_elevation</item>
    </style>

    <style name="ShapeAppearance.MiAgenda.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/corner_small</item>
    </style>

    <style name="ShapeAppearance.MiAgenda.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_medium</item>
    </style>

    <style name="ShapeAppearance.MiAgenda.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_large</item>
    </style>

    <style name="TextAppearance.MiAgenda.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_display</item>
    </style>

    <style name="TextAppearance.MiAgenda.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <style name="TextAppearance.MiAgenda.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.MiAgenda.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.MiAgenda.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
    </style>
</resources>
